rules_version = '2';

// FASE 2 — REGLAS REFORZADAS. PUBLICACIÓN CONFIRMADA POR EL PROPIETARIO (14/10/2026).
// La auditoría anónima en Firebase REAL confirmó lecturas públicas permitidas y
// denegación de likes, ratings e historial de descargas (Actions #38649931569).
// Las interacciones de la tienda ya se envían al backend Vercel con Turnstile.
// Este archivo es la referencia probada; si se editan reglas, probar en Emulator
// antes de aplicar cambios a producción. Guía: docs/fase-02/ACTIVACION_COORDINADA.md.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "eler30.mr@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function appRef(appId) {
      return /databases/$(database)/documents/apps/$(appId);
    }

    function parentPublished(appId) {
      return exists(appRef(appId))
        && get(appRef(appId)).data.status == "published";
    }

    match /apps/{appId} {
      allow read: if isAdmin() || resource.data.status == "published";
      allow create, update, delete: if isAdmin();

      // Contadores agregados y registros de interacción serán mantenidos
      // en transacción por un backend autenticado; Service SDK elude reglas.
      match /likes/{likeId} {
        allow read: if isAdmin();
        allow create, update, delete: if isAdmin();
      }

      match /ratings/{ratingId} {
        allow read: if isAdmin();
        allow create, update, delete: if isAdmin();
      }

      match /downloadClicks/{clickId} {
        allow read: if isAdmin();
        allow create, update, delete: if isAdmin();
      }

      // La lectura pública aprobada se conserva; escritura pasa al backend.
      match /comments/{commentId} {
        allow read: if isAdmin()
          || (parentPublished(appId) && resource.data.approved == true);

        // Publicación de comentarios solo desde API con Turnstile y cuota.
        allow create: if isAdmin();

        allow update, delete: if isAdmin();
      }
    }
  }
}
