{
  "name": "appsem-store-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:baseline": "node --test tests/baseline/*.test.mjs",
    "baseline:scan": "node scripts/baseline-scan.mjs",
    "test:firestore": "firebase emulators:exec --config firebase.phase1.json --project demo-appsem-phase1 --only firestore \"node --test --test-concurrency=1 tests/firestore/*.test.mjs tests/backup/archive-emulator.test.mjs\"",
    "check:phase1": "npm run test:baseline && npm run baseline:scan && npm run build && npm run test:firestore",
    "firestore:backup": "node scripts/firestore/backup.mjs",
    "firestore:verify": "node scripts/firestore/verify.mjs",
    "firestore:restore:demo": "node scripts/firestore/restore-emulator.mjs",
    "test:backup:codec": "node --test tests/backup/codec.test.mjs",
    "firestore:backup:github": "node scripts/firestore/backup-github.mjs",
    "firestore:decrypt": "node scripts/firestore/decrypt-github.mjs",
    "test:backup:encrypted": "node --test tests/backup/encryption.test.mjs",
    "test:phase2:integration": "firebase emulators:exec --config firebase.phase1.json --project demo-appsem-phase2-integration --only firestore \"node --test tests/phase2/metrics-backend-emulator.test.mjs\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "firebase": "10.14.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1",
    "vite": "5.4.19"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "firebase-admin": "12.7.0",
    "firebase-tools": "14.19.1"
  }
}
